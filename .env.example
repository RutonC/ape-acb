APP_NAME="APE, Agência Privada de Emprego"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8021

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT
APP_TIMEZONE=Africa/Maputo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ape.acb.co.mz"
MAIL_FROM_NAME="APE"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Painel de administração
ADMIN_MFA_REQUIRED=true
ADMIN_NAME="Administrador"
ADMIN_EMAIL=info.ape@acb.co.mz
ADMIN_PASSWORD=

# Biblioteca de média: chave que assina os URLs das imagens redimensionadas
# (gerar com: php -r "echo bin2hex(random_bytes(16));")
MEDIA_GLIDE_TOKEN=

# Proxies de confiança (ngrok, Cloudflare): "*" ou lista de IPs; vazio = nenhum
TRUSTED_PROXIES=

SANCTUM_STATEFUL_DOMAINS=localhost:8021,127.0.0.1:8021

# Idiomas do site, separados por vírgulas (pt,en para activar o inglês)
SITE_LOCALES=pt
